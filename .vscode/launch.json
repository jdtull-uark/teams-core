    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Solara App",
            "type": "debugpy",
            "request": "launch",
            "module": "solara",
            "args": ["run", "${workspaceFolder}/examples/psych_safety_example/app.py", "--host", "localhost", "--port", "8765"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "justMyCode": false
        },
    ]
}